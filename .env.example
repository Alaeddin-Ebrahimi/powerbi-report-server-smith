# Copy this file to .env and fill in your own values.
# .env is in .gitignore — never commit real credentials.
#
# Only needed for the pbirs_* tools (Power BI Report Server deployment).
# Leave unset if you're only using the audit/workflow/modeling tools.

PBIRS_BASE_URL=https://your-intranet-host/Reports
PBIRS_USERNAME=DOMAIN\your-service-account
PBIRS_PASSWORD=
PBIRS_VERIFY_SSL=true

# Optional: force the whole server into read-only mode (refuses all write
# tools, audits still run).
PBIRS_SMITH_READONLY=false
